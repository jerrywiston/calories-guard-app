{
  "name": "gemini-nutrition-estimator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "將餐點照片與文字說明送至 Gemini，估算熱量與營養成分。",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:web": "esbuild public/app.js --bundle --format=iife --target=es2022 --minify --loader:.txt=text --outfile=public/app.bundle.js",
    "mobile:sync": "npm run build:web && cap sync",
    "android:open": "npm run mobile:sync && cap open android",
    "android:apk": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "ios:open": "npm run mobile:sync && cap open ios",
    "prestart": "npm run build:web",
    "start": "node server.mjs",
    "analyze": "node analyze-nutrition.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@calories-guard/gallery-saver": "file:plugins/gallery-saver",
    "@capacitor/android": "^8.5.2",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "esbuild": "^0.25.12"
  }
}
